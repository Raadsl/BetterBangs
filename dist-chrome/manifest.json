{
  "manifest_version": 3,
  "name": "BetterBangs",
  "version": "1.4.1",
  "description": "Adds *ALL* DDG !Bangs to a lot of search engines including Startpage, Bing and Google.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://*.startpage.com/*",
    "https://*.google.com/*",
    "https://*.google.nl/*",
    "https://*.bing.com/*",
    "https://*.yahoo.com/*",
    "https://*.ecosia.org/*",
    "https://*.brave.com/*",
    "https://*.swisscows.com/*",
    "https://*.you.com/*",
    "https://*.qwant.com/*",
    "https://*.yandex.com/*",
    "https://*.yandex.ru/*",
    "https://*.mojeek.com/*",
    "https://*.google.co.uk/*",
    "https://*.google.ca/*",
    "https://*.google.com.au/*",
    "https://*.google.de/*",
    "https://*.google.co.in/*",
    "https://*.google.it/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [{
    "resources": ["bangs.json"],
    "matches": ["<all_urls>"]
  }],
  "content_scripts": [
    {
      "matches": [
        "https://*.startpage.com/*",
        "https://*.google.com/*",
        "https://*.google.nl/*",
        "https://*.bing.com/*",
        "https://*.yahoo.com/*",
        "https://*.ecosia.org/*",
        "https://*.brave.com/*",
        "https://*.swisscows.com/*",
        "https://*.you.com/*",
        "https://*.qwant.com/*",
        "https://*.yandex.com/*",
        "https://*.yandex.ru/*",
        "https://*.mojeek.com/*",
        "https://*.google.co.uk/*",
        "https://*.google.ca/*",
        "https://*.google.com.au/*",
        "https://*.google.de/*",
        "https://*.google.co.in/*",
        "https://*.google.it/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_icon": {
      "64": "icons/icon64.png"
    },
    "default_title": "Open BetterBangs",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "500": "icons/icon500.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "BetterBangs@raadsl",
      "strict_min_version": "109.0"
    }
  }
}